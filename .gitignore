# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
dist-electron/
**/dist/
**/dist-electron/

# Runtime / logs / temp
.runtime/
logs/
artifacts/
*.log
.tmp-*
**/.tmp-*

# Tooling / local IDE / AI agents
.opencode/
.claude/
.agents/
.vscode/
*.local

# OS / editor
.DS_Store
Thumbs.db
*.swp
*~

# Env / secrets
.env
.env.*
!.env.example

# Git credentials notes
docs/git-credentials.md

# Test / Playwright (kept out even if reintroduced locally)
playwright-report/
test-results/
**/playwright-results/
coverage/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
*.fixture.json
tests/
**/test/
vitest.config.ts
playwright.config.ts
vite.config.test.ts

# Packaging / binary drops
release/
.exe/
*.exe
*.dmg
*.AppImage

# Tool locks
bun.lock
server.lock.json
sessionSnapshots/

# Local AI-tooling state
.commandcode/
.freebuff/

# Verification screenshots (local artifacts; kept on disk, not versioned)
# 截图是每次改动后的本地验证产物，单个会话可累积数十 MB。
# 进版本库会让仓库永久膨胀且无法瘦身，因此只保留目录占位。
screenshots/*
!screenshots/.gitkeep

# Debug scratch (API dumps, session logs, ad-hoc preview pages)
*.session.md
*.api-dump.json
